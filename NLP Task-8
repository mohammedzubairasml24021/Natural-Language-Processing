    "# -------------------Text Classification Using Naive Bayes----------------------\n",
    "# Naive Bayes is a supervised machine learning algorithm used to classify text documents into predefined categories.\n",
    "#It is based on Bayes Theorem and assumes that the words in a document are independent of each other."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "9f575c87-8fdc-40a1-b135-a74510f79f07",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Text: I love Amet\n",
      "Actual Class: Positive\n",
      "Predicted Class: Positive\n",
      "----------------------\n",
      "Text: Amet is good\n",
      "Actual Class: Positive\n",
      "Predicted Class: Positive\n",
      "----------------------\n",
      "Text: I hate faceprep\n",
      "Actual Class: Negative\n",
      "Predicted Class: Negative\n",
      "----------------------\n",
      "Text: faceprep is terrible\n",
      "Actual Class: Negative\n",
      "Predicted Class: Negative\n",
      "----------------------\n"
     ]
    }
   ],
   "source": [
    "from sklearn.feature_extraction.text import CountVectorizer\n",
    "from sklearn.naive_bayes import MultinomialNB\n",
    "\n",
    "# Training data\n",
    "texts = [\n",
    "    \"I love Amet\",\n",
    "    \"Amet is good\",\n",
    "    \"I hate faceprep\",\n",
    "    \"faceprep is terrible\"\n",
    "]\n",
    "\n",
    "# Labels\n",
    "labels = [\n",
    "    \"Positive\",\n",
    "    \"Positive\",\n",
    "    \"Negative\",\n",
    "    \"Negative\"\n",
    "]\n",
    "\n",
    "# Convert text into numbers\n",
    "vectorizer = CountVectorizer()\n",
    "X = vectorizer.fit_transform(texts)\n",
    "\n",
    "# Create and train Naive Bayes model\n",
    "model = MultinomialNB()\n",
    "model.fit(X, labels)\n",
    "\n",
    "# Predict each training text\n",
    "predictions = model.predict(X)\n",
    "\n",
    "# Display output for each training data\n",
    "for text, actual, predicted in zip(texts, labels, predictions):\n",
    "    print(\"Text:\", text)\n",
    "    print(\"Actual Class:\", actual)\n",
    "    print(\"Predicted Class:\", predicted)\n",
    "    print(\"----------------------\")"
   ]
  },
